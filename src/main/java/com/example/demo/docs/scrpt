CREATE DATABASE IF NOT EXISTS evaluacion_db;

USE evaluacion_db;

-- 1. Eliminar tablas existentes en orden correcto
DROP TABLE IF EXISTS solicitudes;
DROP TABLE IF EXISTS clientes;
DROP TABLE IF EXISTS empleados;
DROP TABLE IF EXISTS administradores;
DROP TABLE IF EXISTS usuarios;

-- 2. Tabla principal: Usuario
CREATE TABLE usuarios (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    correo VARCHAR(150) NOT NULL UNIQUE
) ENGINE = InnoDB;

-- 3. Tabla Administrador
CREATE TABLE administradores (
    id BIGINT PRIMARY KEY,
    nivel_acceso INT NOT NULL,
    CONSTRAINT chk_nivel_acceso
        CHECK (nivel_acceso BETWEEN 1 AND 5),
    CONSTRAINT fk_administrador_usuario
        FOREIGN KEY (id)
        REFERENCES usuarios(id)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 4. Tabla Empleado
CREATE TABLE empleados (
    id BIGINT PRIMARY KEY,
    cargo VARCHAR(100) NOT NULL,
    salario DOUBLE NOT NULL,
    CONSTRAINT chk_salario
        CHECK (salario > 0),
    CONSTRAINT fk_empleado_usuario
        FOREIGN KEY (id)
        REFERENCES usuarios(id)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 5. Tabla Cliente
CREATE TABLE clientes (
    id BIGINT PRIMARY KEY,
    puntos_fidelidad INT NOT NULL DEFAULT 0,
    CONSTRAINT fk_cliente_usuario
        FOREIGN KEY (id)
        REFERENCES usuarios(id)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 6. Tabla Solicitudes
CREATE TABLE solicitudes (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    descripcion TEXT,
    estado VARCHAR(30) NOT NULL DEFAULT 'PENDIENTE',
    fecha_creacion DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    cliente_id BIGINT NOT NULL,

    CONSTRAINT fk_solicitud_cliente
        FOREIGN KEY (cliente_id)
        REFERENCES clientes(id)
        ON DELETE RESTRICT
) ENGINE = InnoDB;
